# ============================================================
# Variables de entorno — copiar a .env.local y completar.
# NUNCA commitear .env.local (ya está en .gitignore).
#
# De dónde sale cada valor:
# - Supabase (URL + keys): dashboard del proyecto rrhh-tecnophos →
#   Settings → API. Pedile a Brandon que te invite al proyecto y
#   copialos vos mismo.
# - Cloudflare R2: pedile a Brandon un API token PROPIO (Cloudflare →
#   R2 → Manage API Tokens → Create, permiso "Object Read & Write"
#   sobre el bucket). Solo hace falta para subir/borrar archivos;
#   podés desarrollar casi todo sin estas dos.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=brandon4320
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
